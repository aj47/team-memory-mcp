{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-memory-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Your environment's AuthKit domain (WorkOS dashboard → Domains, or `workos project list`).
    "AUTHKIT_DOMAIN": "your-subdomain.authkit.app",
    "MEMBERSHIP_CACHE_SECONDS": "60"
  },
  // WORKOS_API_KEY is a secret: `npx wrangler secret put WORKOS_API_KEY`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-memory-mcp",
      // From `npx wrangler d1 create team-memory-mcp`.
      "database_id": "your-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
